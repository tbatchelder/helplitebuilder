{
  "name": "helplite-builder",
  "version": "0.1.0",
  "description": "Compiles a single modified-markdown source file into the global help, page-context, and tooltip assets HelpLite consumes.",
  "private": true,
  "license": "MIT",
  "bin": {
    "helplite-builder": "bin/helplite-builder.js"
  },
  "scripts": {
    "build-help": "node src/build.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "marked": "^18.0.13"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.1",
    "prettier": "^3.9.6",
    "vitest": "^5.0.1"
  }
}
